# ==========================================================================
# GIT IGNORE FILE (.gitignore)
# Root configuration for Blogify Application (Frontend & Node.js Backend)
# ==========================================================================

# 1. Dependency Directories
node_modules/
backend/node_modules/
jspm_packages/
web_modules/

# 2. Environment Variables & Secrets
.env
backend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Logs & Debugging Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# 4. Operating System Junk Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 5. Editor & IDE Settings
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Temporary Scratch Files & Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
scratch/
tmp/
*.tmp

# 7. Production Build Outputs (if applicable)
dist/
build/
out/
